# 実バックエンド接続の切替(reservation-frontend/adr/0009、人間承認 2026-07-28)。
#
# 既定(このファイルをコピーしない・値を設定しない)ではモックのみで動く(Vitest・通常の
# `npm run dev`・CIは全てこの既定に依存する)。実際にreservation-system(GET /rooms、
# 既定ポート8080)へ接続したい場合だけ、`.env.local`(gitignore対象、*.local)にコピーして
# 値を"true"にする。
#
# 接続経路はVite dev serverのproxy(vite.config.tsのserver.proxy、`/rooms` -> localhost:8080)。
# バックエンド側の変更(CORS追加等)は不要・行わない。
VITE_USE_REAL_ROOMS_API=false

# GET /rooms/{roomId}/availability の実接続切替(reservation-frontend/adr/0009 決定6(b)、
# 2本目の実接続)。roomsと同じ方式: Vite dev server proxyの `/rooms` ルールが前方一致で
# availabilityパスもカバーするためproxy追加は不要、バックエンドは無変更(CORSを足さない)。
# 実用上はroomsとavailabilityを両方 true にしないと画面が機能しない(FR-007。実DBのUUIDと
# モックのroomIdが食い違い、availabilityがモックのままだと必ずROOM_NOT_FOUNDになるため)。
VITE_USE_REAL_AVAILABILITY_API=false
