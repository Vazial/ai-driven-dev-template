# 実バックエンド接続の切替(reservation-frontend/adr/0009、人間承認 2026-07-28)。
#
# ファイル名について(meta/adr/0040): 本ファイルは慣習的な `.env.example` ではなく
# `env.example` である。Claude Codeの権限設定は `.env*` を deny しており、**deny は allow で
# 上書きできず除外構文も無い**(実測)。`.env.example` のままだとAIが保守できず、実際に
# 3本目・4本目の実接続でフラグの追記が漏れた。機密の default-deny を緩めるのではなく、
# 機密でないテンプレートを `.env*` の名前空間から出すことで両立させている。
#
# 既定(このファイルをコピーしない・値を設定しない)ではモックのみで動く(Vitest・通常の
# `npm run dev`・CIは全てこの既定に依存する)。実際にreservation-system(既定ポート8080)へ
# 接続したい場合だけ、`.env.local`(gitignore対象)にコピーして値を"true"にする。
#
# 接続経路はVite dev serverのproxy(vite.config.tsのserver.proxy、`/rooms` -> localhost:8080)。
# バックエンド側の変更(CORS追加等)は不要・行わない。
VITE_USE_REAL_ROOMS_API=false

# GET /rooms/{roomId}/availability の実接続切替(reservation-frontend/adr/0009 決定6(b)、
# 2本目の実接続)。roomsと同じ方式: Vite dev server proxyの `/rooms` ルールが前方一致で
# availabilityパスもカバーするためproxy追加は不要、バックエンドは無変更(CORSを足さない)。
# 実用上はroomsとavailabilityを両方 true にしないと画面が機能しない(FR-007。実DBのUUIDと
# モックのroomIdが食い違い、availabilityがモックのままだと必ずROOM_NOT_FOUNDになるため)。
VITE_USE_REAL_AVAILABILITY_API=false

# POST /reservations の実接続切替(3本目。初の「書き込み」の実接続)。
# proxyは `/reservations` ルールを新設済み(`/rooms` の前方一致ではカバーされないため)。
# 部分的に実APIにすると**書き込み結果の可視性**が分断される(FR-007と同型の別種): 作成した
# 予約は実バックエンドに入るため、availabilityがモックのままだとタイムラインに現れない。
VITE_USE_REAL_RESERVATIONS_API=false

# POST /reservations/{reservationId}/cancel の実接続切替(4本目)。proxyは `/reservations`
# ルールが前方一致でカバーするため追加不要。キャンセルは契約が reserverId を必須で要求するため、
# 端末ローカル記録(myReservationsStore)が予約時にreserverIdを保持している必要がある。
VITE_USE_REAL_RESERVATIONS_CANCEL_API=false

# 4本すべてを true にして初めて「空き確認 -> 予約 -> キャンセル」が実物で通る。
# 1本だけ実APIにすると識別子空間(FR-007)または書き込み結果の可視性が分断される。
