{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dining-radar-live",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "projects/dining-radar/manage.py",
        "runserver",
        "127.0.0.1:8020",
        "--noreload",
        "--insecure"
      ],
      "port": 8020,
      "env": {
        "DJANGO_ALLOWED_HOSTS": "127.0.0.1,localhost"
      }
    },
    {
      "name": "reservation-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "projects/reservation-frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "reservation-frontend-real-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "projects/reservation-frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "VITE_USE_REAL_ROOMS_API": "true",
        "VITE_USE_REAL_AVAILABILITY_API": "true",
        "VITE_USE_REAL_RESERVATIONS_API": "true",
        "VITE_USE_REAL_RESERVATIONS_CANCEL_API": "true"
      }
    }
  ]
}
